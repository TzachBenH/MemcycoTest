{
  "name": "scheduler-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "UI for the Scheduling System: manage scheduled executions of predefined tasks",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@mui/x-date-pickers": "7.29.4",
    "@tanstack/react-query": "5.108.4",
    "axios": "1.21.1",
    "cronstrue": "2.59.0",
    "dayjs": "1.11.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.92.0",
    "react-router-dom": "7.18.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.7",
    "@types/react": "18.3.32",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
