# Optional overrides for docker-compose.yml. Every value below is the default, so this file is not required.
# To change something: cp docker/.env.example docker/.env and edit docker/.env (it is git-ignored).

# --- PostgreSQL (shared by both backend instances) ---
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler

# --- Host ports ---
# UI (nginx): http://localhost:3000
FRONTEND_PORT=3000
# backend-1 directly; Swagger UI at http://localhost:8080/swagger-ui.html
BACKEND_PORT=8080
# PostgreSQL; 5433 avoids a clash with a locally installed PostgreSQL on 5432
POSTGRES_PORT=5433

# --- Backend tuning (per instance) ---
# How many tasks can run at the same time on one instance
QUARTZ_THREADS=10
# JDBC connections; keep it above QUARTZ_THREADS (API requests and system jobs need connections too)
DB_POOL_SIZE=20
# Container memory limit; the JVM heap is 75% of it
BACKEND_MEMORY_LIMIT=1g

# Only needed when calling the API from another origin (the UI on :3000 uses the same origin through nginx)
CORS_ALLOWED_ORIGINS=http://localhost:3000
